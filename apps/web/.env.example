# URL publica del sitio. Se usa para metadata, Open Graph, sitemap y robots.
# El dominio definitivo esta pendiente (docs/WEB.md §1), asi que vive aqui
# y no escrito en el codigo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# En produccion: https://altec.group — de aqui salen los enlaces de acceso que
# viajan por correo, asi que tiene que coincidir con el dominio real.

# Formulario de contacto (docs/WEB.md §4.5). Sin estas variables el formulario
# valida pero no envia: muestra el correo directo como alternativa.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ALTEC Group <no-reply@altec.mx>
CONTACT_TO_EMAIL=contacto@altec.mx

# Cerebro de Camila. Modelo: claude-opus-5.
ANTHROPIC_API_KEY=

# Avatar, voz y lip-sync. La key nunca llega al navegador: el servidor la
# cambia por un token de sesion de corta vida.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# --- Supabase: acceso y contenido confidencial ---
# Una sola puerta para el Documento Oficial del Holding (/document) y la
# consola de Camila (/camila). Quien entra lo hace con su correo, queda
# registrado, y se le puede revocar el acceso sin tocar el de los demas.
#
# Las dos primeras son publicas y llegan al navegador; la llave de anon no da
# ningun privilegio por si misma, lo que decide son las politicas RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Esta se salta RLS entera. Solo servidor y scripts de administracion; nunca en
# una variable con prefijo NEXT_PUBLIC_, nunca en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
