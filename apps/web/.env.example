# URL publica del sitio. Se usa para metadata, Open Graph, sitemap y robots.
# El dominio definitivo esta pendiente (docs/WEB.md §1), asi que vive aqui
# y no escrito en el codigo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (docs/WEB.md §4.5). Sin estas variables el formulario
# valida pero no envia: muestra el correo directo como alternativa.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ALTEC Group <no-reply@altec.mx>
CONTACT_TO_EMAIL=contacto@altec.mx

# --- Camila Fuentes, Senior Partner AI (/camila) ---
# Su contexto incluye el cap table y el monto de la ronda, por eso la consola
# esta detras de un codigo. Sin estas dos, la pagina no abre.
CAMILA_ACCESS_CODE=
CAMILA_COOKIE_SECRET=

# Cerebro de Camila. Modelo: claude-opus-5.
ANTHROPIC_API_KEY=

# Avatar, voz y lip-sync. La key nunca llega al navegador: el servidor la
# cambia por un token de sesion de corta vida.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# --- Documento Oficial del Holding (/document) ---
# El documento lleva cap table, valuacion, salarios por nivel y la
# justificacion de participacion socio por socio. Sin estas dos variables la
# pagina no abre y lo dice; no finge una puerta que no existe.
DOC_ACCESS_CODE=
DOC_COOKIE_SECRET=
