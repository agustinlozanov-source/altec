# URL publica del sitio. Se usa para metadata, Open Graph, sitemap y robots.
# El dominio definitivo esta pendiente (docs/WEB.md §1), asi que vive aqui
# y no escrito en el codigo.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Formulario de contacto (docs/WEB.md §4.5). Sin estas variables el formulario
# valida pero no envia: muestra el correo directo como alternativa.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=ALTEC Group <no-reply@altec.mx>
CONTACT_TO_EMAIL=contacto@altec.mx
