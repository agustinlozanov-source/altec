{
  "name": "altec",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,css,md,json,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md,json,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.4",
    "turbo": "^2.11.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  }
}
